# Copy this template to the repository-root .env only if .env does not exist.
# Otherwise add the required fields to the existing .env without replacing it.
# One shared .env for the project. Fill only the providers you use.
# Never commit real values or paste credentials into chat.

# NVIDIA NIM
NVIDIA_API_KEY=

# Frontier completion APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Financial Modeling Prep data
FMP_API_KEY=

# Modal account API token: deploy, inspect and stop resources.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal endpoint proxy credential: proxy token ID + '.' + proxy token secret.
# Example format only: wk-<id>.ws-<secret>
MODAL_PROXY_BEARER=

# Full chat-completions URL of your deployed Modal app (profile modal-gpt-oss-20b).
# Example format only: https://<workspace>--<app>.modal.run/v1/chat/completions
MODAL_ENDPOINT_URL=

# Optional token for gated Hugging Face artifacts; public GPT-OSS needs none.
HF_TOKEN=

# FMP Data API
FMP_API_TOKEN=
