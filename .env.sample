# Copy this template to the repository-root .env only if .env does not exist.
# Otherwise add the required fields to the existing .env without replacing it.
# One shared .env for the project. Fill only the providers you use.
# Never commit real values or paste credentials into chat.

# NVIDIA NIM
NVIDIA_API_KEY=

# Frontier completion APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Financial Modeling Prep data
FMP_API_KEY=

# Modal account API token: deploy, inspect and stop resources.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Modal endpoint proxy credential: proxy token ID + '.' + proxy token secret.
# Example format only: wk-<id>.ws-<secret>
MODAL_PROXY_BEARER=

# Full chat-completions URL of your deployed Modal app (profile modal-gpt-oss-20b).
# Example format only: https://<workspace>--<app>.modal.run/v1/chat/completions
MODAL_ENDPOINT_URL=

# Gateway chat-completions URL for llama-server (profile llamacpp-gemma3-4b, gateway port 11571).
LLAMACPP_ENDPOINT_URL=

# Gateway base URL for the full-distribution host (profile llamacpp-gemma3-4b, gateway port 11581).
FULL_DISTRIBUTION_ENDPOINT_URL=

# Bearer token for the Windows Ollama gateway (scripts/hosts/serve_local_ollama.ps1).
# Leave empty: the first start generates a random value here.
LOCAL_MODEL_API_KEY=

# Optional token for gated Hugging Face artifacts; public GPT-OSS needs none.
HF_TOKEN=

# FMP Data API
FMP_API_TOKEN=

# FRED API key (free) for point-in-time macro series in the finance simulation.
FRED_API_KEY=

# SEC EDGAR fair-access identity (required by SEC for automated requests); public, not a secret.
SEC_USER_AGENT=recall_guard research marius.ciepluch@hanse-hedge.fund
